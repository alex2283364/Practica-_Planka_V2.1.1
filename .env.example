# =============================================================================
# PLANKA - ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# =============================================================================

# -----------------------------------------------------------------------------
# ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ
# -----------------------------------------------------------------------------

# Базовый URL, по которому будет доступно приложение
BASE_URL=http://localhost:3000

# Секретный ключ для подписи JWT-токенов
# Сгенерируйте командой: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Уровень логирования: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Доверять ли заголовкам X-Forwarded-* (при работе за reverse-proxy)
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# НАСТРОЙКИ БАЗЫ ДАННЫХ (POSTGRESQL)
# -----------------------------------------------------------------------------

# Строка подключения к базе данных (переопределяет POSTGRES_* переменные)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/planka

# Имя базы данных
POSTGRES_DB=planka

# Пользователь базы данных
POSTGRES_USER=postgres

# Пароль базы данных (ОБЯЗАТЕЛЬНО СМЕНИТЬ!)
POSTGRES_PASSWORD=postgres

# Дополнительные аргументы инициализации PostgreSQL
POSTGRES_INITDB_ARGS=-c shared_buffers=256MB -c max_connections=200

# -----------------------------------------------------------------------------
# НАСТРОЙКИ REDIS (КЭШ)
# -----------------------------------------------------------------------------

# Пароль для Redis (ОБЯЗАТЕЛЬНО СМЕНИТЬ!)
REDIS_PASSWORD=redis-password

# -----------------------------------------------------------------------------
# АДМИНИСТРАТОР ПО УМОЛЧАНИЮ (создаётся при первом запуске)
# -----------------------------------------------------------------------------

# Email администратора
DEFAULT_ADMIN_EMAIL=admin@example.com

# Пароль администратора (ОБЯЗАТЕЛЬНО СМЕНИТЬ!)
DEFAULT_ADMIN_PASSWORD=admin

# Имя администратора
DEFAULT_ADMIN_NAME=Administrator

# Имя пользователя администратора
DEFAULT_ADMIN_USERNAME=admin

# -----------------------------------------------------------------------------
# ОГРАНИЧЕНИЯ РЕСУРСОВ (Docker Compose deploy.resources)
# -----------------------------------------------------------------------------

# Planka
PLANKA_CPU_LIMIT=1
PLANKA_MEMORY_LIMIT=1G
PLANKA_CPU_RESERVATION=0.5
PLANKA_MEMORY_RESERVATION=512M

# PostgreSQL
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=512M
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEMORY_RESERVATION=256M

# Redis
REDIS_CPU_LIMIT=0.25
REDIS_MEMORY_LIMIT=256M
REDIS_CPU_RESERVATION=0.1
REDIS_MEMORY_RESERVATION=128M

# -----------------------------------------------------------------------------
# ПОРТЫ (опционально)
# -----------------------------------------------------------------------------

# Порт для Planka (на хосте)
PLANKA_PORT=3000

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ (опционально, см. документацию Planka)
# -----------------------------------------------------------------------------

# # Максимальный размер загружаемого файла
# MAX_UPLOAD_FILE_SIZE=

# # Лимит хранилища
# STORAGE_LIMIT=

# # Лимит активных пользователей
# ACTIVE_USERS_LIMIT=

# # Язык по умолчанию
# DEFAULT_LANGUAGE=en-US

# # Настройки SMTP для уведомлений по почте
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=user@example.com
# SMTP_PASSWORD=smtp-password
# SMTP_FROM="Planka" <noreply@example.com>

# # Настройки S3 для хранения файлов
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=planka-files
# S3_FORCE_PATH_STYLE=true

# # Настройки OIDC (SSO)
# OIDC_ISSUER=https://your-oidc-provider
# OIDC_CLIENT_ID=planka-client
# OIDC_CLIENT_SECRET=oidc-secret
# OIDC_SCOPES=openid email profile
# OIDC_ADMIN_ROLES=admin
# OIDC_ENFORCED=false